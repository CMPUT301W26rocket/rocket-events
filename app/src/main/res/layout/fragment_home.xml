<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_events_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Events"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_scan_qr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/purple_circle"
            android:contentDescription="Scan QR code"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera"
            android:tooltipText="Scan QR code"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_open_create_event"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/purple_circle"
            android:contentDescription="Create event"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_add"
            android:tooltipText="Create event"
            app:tint="@android:color/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1" />

</LinearLayout>
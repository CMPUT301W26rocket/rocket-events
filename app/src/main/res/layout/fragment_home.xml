<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_events_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="All Events"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_scan_qr"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/purple_circle"
            android:contentDescription="Scan QR code"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_menu_camera"
            android:tooltipText="Scan QR code"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_open_create_event"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/purple_circle"
            android:contentDescription="Create event"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_input_add"
            android:tooltipText="Create event"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Search bar (US 01.01.05) -->
    <EditText
        android:id="@+id/edit_search"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/filter_chip_background"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="Search events..."
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/color_text_dark"
        android:textColorHint="@color/color_hint"
        android:textSize="14sp" />

    <!-- Filter chips (US 01.01.04) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_available"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_chip_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Open Now"
                android:textColor="@color/filter_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_upcoming"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_chip_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Upcoming"
                android:textColor="@color/filter_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_small"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_chip_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Small (\u226420)"
                android:textColor="@color/filter_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_medium"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/filter_chip_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Medium (21\u201350)"
                android:textColor="@color/filter_chip_text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_large"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/filter_chip_background"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Large (50+)"
                android:textColor="@color/filter_chip_text_color"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Empty state when no events match -->
    <TextView
        android:id="@+id/text_no_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="No events match your search"
        android:textColor="@color/color_hint"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_events"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
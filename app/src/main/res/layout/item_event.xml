<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/event_card_background"
    android:clipToOutline="true"
    android:orientation="vertical">

    <!-- Poster image — clips to card's rounded top corners via clipToOutline -->
    <ImageView
        android:id="@+id/image_event_poster"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_image_placeholder"
        android:background="@color/color_placeholder_bg"
        android:contentDescription="Event poster" />

    <!-- Title and organizer row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_event_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Event Name"
                android:textColor="#4B3F57"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_event_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Organizer"
                android:textColor="#7A6A87"
                android:textSize="14sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/image_event_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Open event"
            android:src="@drawable/baseline_arrow_forward_24"
            app:tint="#5C4A6E" />

    </LinearLayout>

    <!-- Status badges row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/badge_registration"
            android:layout_marginEnd="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/badge_background"/>

        <TextView
            android:id="@+id/badge_waitlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/badge_background"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>

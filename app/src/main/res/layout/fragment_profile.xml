<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFEF7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF6200EE"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"/>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update your personal information below."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginBottom="32dp"/>

        <!-- Name Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. Jane Smith"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:background="@drawable/rounded_input"
            android:layout_marginBottom="20dp"/>

        <!-- Email Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address *"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. jane@email.com"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:background="@drawable/rounded_input"
            android:layout_marginBottom="20dp"/>

        <!-- Phone Field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number (optional)"
            android:textSize="14sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/editTextPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="e.g. 780-555-0123"
            android:inputType="phone"
            android:padding="12dp"
            android:background="@drawable/rounded_input"
            android:layout_marginBottom="32dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/buttonSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Changes"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            android:layout_marginBottom="16dp"/>

        <!-- Opt Out of Notifications Button -->
        <Button
            android:id="@+id/buttonOptOutNotifications"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Opt Out of Notifications"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            android:layout_marginBottom="16dp"/>

        <!-- Event History Button -->
        <Button
            android:id="@+id/buttonEventHistory"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Event History"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            android:layout_marginBottom="16dp"/>

        <!-- Delete Profile Button -->
        <Button
            android:id="@+id/buttonDeleteProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Delete Profile"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6200EE"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>

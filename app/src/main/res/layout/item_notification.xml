<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="8dp"
    android:elevation="0dp"
    android:background="@drawable/event_card_background">

    <TextView
        android:id="@+id/text_notification_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:textSize="11sp"
        android:textColor="#333333"
        android:text="Just now"/>

    <TextView
        android:id="@+id/text_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/text_notification_time"
        android:layout_marginEnd="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#2B1F37"
        android:text="Event Title"/>

    <TextView
        android:id="@+id/text_notification_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_notification_title"
        android:layout_alignParentStart="true"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textColor="#3D2F4A"
        android:text="Notification message"/>

    <View
        android:id="@+id/view_unread_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_below="@id/text_notification_time"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/purple_circle"
        android:visibility="invisible"/>

</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"/>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/textAdminWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome, Admin!"
            android:textSize="15sp"
            android:textColor="@color/color_text_medium"
            android:layout_marginBottom="40dp"/>

        <!-- Section: Browse -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Browse and Manage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_dark"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBrowseEvents"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Browse Events"
            android:textSize="16sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBrowseProfiles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Browse Profiles"
            android:textSize="16sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBrowseOrganizers"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Browse Organizers"
            android:textSize="16sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnBrowseImages"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Browse Event Posters"
            android:textSize="16sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="24dp"/>

        <!-- Section: Logs -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Monitoring"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_dark"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnViewLogs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View Notification Logs"
            android:textSize="16sp"
            android:textColor="@color/color_on_primary"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="40dp"/>

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Logout"
            android:textSize="16sp"
            android:textColor="@color/color_primary"
            android:backgroundTint="@color/color_background"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>

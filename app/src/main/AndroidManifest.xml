<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for saving QR codes / test images to the gallery on API 24–28.
         API 29+ uses MediaStore scoped storage and does not need this permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Required for the QR code scanner -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Required for capturing entrant location when joining a geolocation-required event -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="EventLotteryApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventLotteryApp">

        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.auth.ProfileSetupActivity" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <!-- Deep link: eventlotteryapp://event/{eventId} — encoded in QR codes -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eventlotteryapp" android:host="event" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.admin.AdminActivity" android:exported="false" />
        <activity android:name=".ui.admin.AdminBrowseProfilesActivity" />
        <activity android:name=".ui.admin.AdminProfileDetailActivity" />
        <activity android:name=".ui.admin.AdminBrowseOrganizersActivity" />
        <activity android:name=".ui.admin.AdminOrganizerDetailActivity" />
        <activity android:name=".ui.admin.AdminBrowseEventsActivity" />
        <activity android:name=".ui.admin.AdminEventDetailActivity" />
        <activity android:name=".ui.admin.AdminBrowseImagesActivity" />
        <activity android:name=".ui.admin.AdminImageDetailActivity" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyB1yzYgYAFYQxZMTHxo_Ex8yFyFWOMgrLM" />

    </application>

</manifest>
